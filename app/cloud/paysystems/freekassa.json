{
    "title": "FreeKassa",
    "description": "Прием оплаты картами, СБП, электронными кошельками и криптовалютой через FreeKassa",
    "version": "1.0.0",
    "infoMessage": "<p>В <a href=\"https://merchant.freekassa.net\" target=\"_blank\">настройках магазина</a> укажите URL оповещения <b>https://ВАШ_ДОМЕН/shm/pay_systems/freekassa.cgi</b> (метод POST) и задайте оба секретных слова.</p><p>Для копии платежной системы добавьте к адресу <b>?ps=ключ_копии</b>.</p>",
    "fields": [
        { "name": "name", "label": "Название для клиентов", "type": "text", "required": true, "default": "FreeKassa" },
        { "name": "show_for_client", "label": "Показывать клиентам", "type": "checkbox", "default": true },
        { "name": "weight", "label": "Порядок в списке (больше - выше)", "type": "number", "default": 0 },
        { "name": "merchant_id", "label": "ID магазина", "type": "text", "required": true },
        { "name": "secret_word_1", "label": "Секретное слово 1 (форма оплаты)", "type": "password", "required": true },
        { "name": "secret_word_2", "label": "Секретное слово 2 (оповещения)", "type": "password", "required": true },
        {
            "name": "currency",
            "label": "Валюта",
            "type": "select",
            "default": "RUB",
            "options": [
                { "value": "RUB", "label": "RUB" },
                { "value": "USD", "label": "USD" },
                { "value": "EUR", "label": "EUR" },
                { "value": "UAH", "label": "UAH" },
                { "value": "KZT", "label": "KZT" }
            ]
        },
        {
            "name": "lang",
            "label": "Язык формы оплаты",
            "type": "select",
            "default": "ru",
            "options": [
                { "value": "ru", "label": "Русский" },
                { "value": "en", "label": "English" }
            ]
        }
    ]
}
